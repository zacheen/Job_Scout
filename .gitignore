# Local-only resume used for development runs; the cloud run reads RESUME_TEXT secret.
resume.txt
.env
# Ledger shard dirs (local_data/, cloud_data/) are NOT ignored — new shards must
# stay `git add`-able — but belong only on the `data` branch; never commit from main.
.ledger/
# On-demand audit output of audit_dropped.py — regenerate anytime, never commit.
dropped_jobs.txt
# Per-checkout digest checkpoint stamp (see jobscout/config.py) — local only.
digest_checkpoint.txt
# Append-only record of pagination cap hits (see jobscout/config.py) — local only.
catchup_cap_hits.txt
__pycache__/
*.pyc
.venv/
# Claude research/probe notes — local only (condensed facts live in Claude memory).
notes/
# Single-instance lock held by local_run.py — local only, never commit.
local_run.lock
