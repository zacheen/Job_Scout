# LOCAL runs only. Copy to `.env` (gitignored) and fill in:  cp .env.example .env
# GitHub Actions never reads this file — set the same names as repository Secrets.
# NEVER put real secrets in config.yaml or any committed file (the repo is public).

# Gmail SMTP sender + recipient. GMAIL_APP_PASSWORD is a 16-char App Password
# (requires 2FA: Google Account > Security > 2-Step Verification > App passwords) —
# your normal login password is rejected by SMTP (535).
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_TO=

# Optional. Scoring uses the best available tier: OpenAI API > local agent CLI > keyword-only.
# Key comes from platform.openai.com (its own billing) — a ChatGPT subscription is NOT an API key.
OPENAI_API_KEY=

# Optional, tier 2 (used only when OPENAI_API_KEY is blank): which scoring CLIs to drive
# and in what order, best first. Names are the config.yaml `llm_clis` entries; a name left
# out is not tried at all, so `LLM_CLIS=claude` pins the whole run to Claude. Blank uses
# config.yaml's own order. A name matching no entry aborts the run rather than quietly
# falling through to keyword-only scoring.
LLM_CLIS=

# Optional: full path to one of those CLI exes, for when it isn't on the process PATH.
# No quotes, spaces are fine; the flags always come from config.yaml (llm_clis), never
# from here. CLAUDE_CLI is Claude Code, AGY_CLI is the Antigravity CLI, GPT_CLI is codex.
CLAUDE_CLI=
AGY_CLI=
GPT_CLI=

# Optional: separate local ledger DIRECTORY (one csv per company) so local runs
# don't share "seen" state with the cloud ledger (cloud_data/ on the `data` branch).
# LEDGER_DIR=local_data_alt

# Resume text that drives the experience score. Locally you may leave this blank and
# put your resume in a gitignored `resume.txt` at the repo root instead.
# In Actions, set RESUME_TEXT as a secret.
RESUME_TEXT=
